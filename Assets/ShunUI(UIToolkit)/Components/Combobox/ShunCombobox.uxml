    <shun:ShunCombobox placeholder="Select a fruit" is-open="false" search-icon="project://database/Assets/ShunUI(UIToolkit)/Resources/Icons/search.png?fileID=2800000&amp;guid=830f7aff9dc83472c94f54fd486ca912&amp;type=3#search" no-results-message="No fruit found" selected-icon="project://database/Assets/ShunUI(UIToolkit)/Resources/Icons/check.png?fileID=2800000&amp;guid=8065da38cbd784dc2be8f7cfdb7dc829&amp;type=3#check" search-placeholder="Search fruit...">
