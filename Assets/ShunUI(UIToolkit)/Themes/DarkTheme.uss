:root {
    --color-background: rgba(36, 36, 36, 0.9490196);
    --color-foreground: rgba(251, 251, 251, 1);
    --color-border: rgba(255, 255, 255, 0.1);
    --color-ring: rgba(141, 141, 141, 1);
    --color-input: rgba(68, 68, 68, 1);
    --color-primary: rgba(74, 113, 178, 1);
    --color-primary-foreground: rgba(255, 255, 255, 1);
    --color-secondary: rgba(68, 68, 68, 1);
    --color-secondary-foreground: rgba(251, 251, 251, 1);
    --color-accent: rgba(94, 94, 94, 1);
    --color-accent-foreground: rgba(251, 251, 251, 1);
    --color-muted: rgba(68, 68, 68, 1);
    --color-muted-foreground: rgba(180, 180, 180, 1);
    --color-card: rgba(52, 52, 52, 0.9490196);
    --color-card-foreground: rgba(251, 251, 251, 1);
    --color-popover: rgba(36, 36, 36, 0.9490196);
    --color-popover-foreground: rgba(251, 251, 251, 1);
    --color-destructive: rgba(220, 49, 46, 1);
    --color-destructive-foreground: rgba(251, 251, 251, 1);
    --border-radius: 4px;
    --border-radius-md: 4px;
    --border-radius-lg: 6px;
    --border-radius-sm: 2px;
    --border-width: 2px;
}
