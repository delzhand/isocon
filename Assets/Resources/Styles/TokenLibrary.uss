#TokenLibraryItem.selectable:active,
#TokenLibraryItem.selectable:hover {
    /* background-color: #2C5D87; */
    background-color: var(--color-muted-foreground);
}

#Frame {
    overflow: hidden;
    height: 78px;
    width: 78px;
}

#Sprite {
    position: absolute;
    height: 100%;
    top: 0;
    left: 0;
}