<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Styles/GlobalStyles.uss?fileID=7433441132597879392&amp;guid=7121076cb2a24ed45a625b144b837ee6&amp;type=3#GlobalStyles"/>
    <ui:VisualElement name="MaleghastActorPanel" class="panel edit-panel" style="position: relative; display: flex; -unity-background-image-tint-color: rgba(255, 255, 255, 0); transition-property: left, opacity; transition-duration: 0.3s, 0.3s; transition-timing-function: ease-in-out, ease-in-out; align-items: flex-start; color: rgb(34, 34, 34);">
        <ui:VisualElement name="Row" style="flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); align-items: flex-end;">
            <ui:VisualElement name="Column" style="align-self: auto; min-width: 260px;">
                <ui:VisualElement name="Id" style="flex-grow: 0; background-color: rgb(255, 255, 255); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; -unity-font-definition: resource(&quot;Fonts/Georgia&quot;);">
                    <ui:Label text="Gunwight" name="UnitName" style="-unity-font-definition: resource(&quot;Fonts/Metal Blackletter_v4&quot;); font-size: 24px; -unity-text-align: upper-center; margin-bottom: 0; padding-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; padding-top: 16px; padding-right: 16px; padding-left: 16px; background-color: rgb(109, 0, 191);"/>
