                </ui:VisualElement>
                <ui:VisualElement name="HpBar" style="flex-grow: 0; background-color: rgb(255, 255, 255); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 0; border-left-width: 1px; -unity-font-definition: resource(&quot;Fonts/Georgia&quot;);">
                    <ui:Label text="HP" name="HpLabel" style="-unity-font-definition: resource(&quot;Fonts/Metal Blackletter_v4&quot;); font-size: 14px; -unity-text-align: upper-center; margin-bottom: 0; padding-bottom: 0; background-color: rgb(194, 194, 194); margin-top: 0; margin-right: 0; margin-left: 0; border-bottom-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); padding-top: 8px; padding-right: 4px; padding-left: 4px;"/>
                    <ui:VisualElement name="HpBar" style="flex-grow: 1; flex-direction: row; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-items: center; justify-content: center;">
